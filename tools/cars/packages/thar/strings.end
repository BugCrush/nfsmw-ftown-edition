[VERSN2]
// The car's name in every language file (and its label in Labels.bin), as the Challenger mod does.

if file_exists absolute Languages\Danish.bin
do
new negate Languages\Danish.bin
add_or_update_string Languages\Danish.bin STRBlocks GLOBAL AUTO CARNAME_MAHINDRA_THAR "Mahindra Thar"
delete Languages\Danish.bin
else // do nothing
end

